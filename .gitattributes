# 统一行尾：所有文本文件使用 LF，仅 Windows 脚本保留 CRLF
* text=auto eol=lf

# 明确指定常见文本文件
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.sol  text eol=lf
*.md   text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.env* text eol=lf

# Windows 脚本保留 CRLF
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# 二进制文件，不做行尾处理
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary
